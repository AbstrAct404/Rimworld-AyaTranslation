<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>Defs/ResearchTabDef[defName="HAR_SK_ResearchTab" and not(generalTitle) and not(generalDescription)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ResearchTabDef[defName="HAR_SK_ResearchTab"]</xpath>
      <value>
        <generalTitle>亚人兽娘研究项目</generalTitle>
        <generalDescription>研究亚人工业的食品、医疗、商店、回收与炼油技术。</generalDescription>
      </value>
    </match>
  </Operation>
</Patch>