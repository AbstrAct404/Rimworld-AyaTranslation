<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <success>Always</success>
    <xpath>Defs/ResearchTabDef[defName="HAR_SL_ResearchTab" and not(generalTitle) and not(generalDescription)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ResearchTabDef[defName="HAR_SL_ResearchTab"]</xpath>
      <value>
        <generalTitle>飞蛾姬研究项目</generalTitle>
        <generalDescription>研究飞蛾姬使用的亚人工业高级医疗技术与配方。</generalDescription>
      </value>
    </match>
  </Operation>
</Patch>